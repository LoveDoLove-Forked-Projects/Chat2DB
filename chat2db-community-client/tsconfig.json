{
  "extends": "./src/.umi/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "paths": {
      "@/*": ["src/*"],
      "@@/*": ["src/.umi/*"],
      "@edition-ui": ["src/edition-ui/community.tsx"],
      "umi": ["node_modules/umi"],
      "umi/typings": ["src/.umi/typings"]
    }
  }
}
